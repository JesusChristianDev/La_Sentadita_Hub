{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:unit": "pnpm run test:unit:build && pnpm run test:unit:run",
    "test:unit:build": "tsc -p tsconfig.unit-tests.json",
    "test:unit:run": "node --test .unit-test-dist/modules/auth_users/application/selfProfileMutationRules.test.js .unit-test-dist/modules/employees/application/employeeMutationRules.test.js .unit-test-dist/modules/employees/application/employeeMutationService.test.js .unit-test-dist/modules/schedule/application/shiftValidation.test.js .unit-test-dist/modules/schedule/application/scheduleCalculations.test.js .unit-test-dist/modules/schedule/application/scheduleDates.test.js .unit-test-dist/modules/schedule/application/scheduleDraftRules.test.js .unit-test-dist/modules/schedule/application/scheduleDraftService.test.js .unit-test-dist/modules/schedule/application/scheduleLockService.test.js .unit-test-dist/modules/schedule/application/schedulePublicationService.test.js",
    "test:vitest": "vitest run --passWithNoTests",
    "test:vitest:watch": "vitest --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier . --write",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-email/components": "^1.0.10",
    "@sentry/nextjs": "^10.45.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.94.1",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-query": "^5.91.2",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.575.0",
    "mindee": "^5.1.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "recharts": "^3.8.0",
    "resend": "^6.9.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
